# Required during the Render Blueprint Apply step.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=
API_ENCRYPTION_KEY=

# Optional. Required only for Sim's built-in Copilot chat.
# Generate in Sim Cloud's Copilot settings.
COPILOT_API_KEY=

# Optional AI provider keys for workflow agent blocks and embeddings.
# These do not enable the built-in Copilot chat.
OPENAI_API_KEY=
ANTHROPIC_API_KEY_1=
GEMINI_API_KEY_1=
MISTRAL_API_KEY=
OLLAMA_URL=
VLLM_BASE_URL=

# Render wires these automatically in render.yaml.
DATABASE_URL=
BETTER_AUTH_URL=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SOCKET_URL=
SOCKET_SERVER_URL=
BETTER_AUTH_SECRET=
INTERNAL_API_SECRET=
